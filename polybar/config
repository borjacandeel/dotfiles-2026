[colors]
foreground = #E0DEF4
background = #191724
color1 = #EB6F92
color2 = #F6C177
color3 = #EBBCBA
color4 = #31748F
color5 = #9CCFD8
color6 = #C4A7E7
color7 = #E0DEF4
color8 = #6E6A86
color9 = #EB6F92
alert = #EB6F92

[bar/bar]
enable-ipc = true
height = 28
width = 100%
offset-y = 0
padding = 2
module-margin = 1

background = ${colors.background}
foreground = ${colors.foreground}

line-size = 2
line-color = ${colors.color1}

font-0 = "CaskaydiaCove Nerd Font:style=Regular:size=11;3"
font-1 = "CaskaydiaCove Nerd Font:style=Bold:size=11;3"
font-2 = "CaskaydiaCove Nerd Font:size=14;4"
font-3 = "CaskaydiaCove Nerd Font:size=10;3"
font-4 = "CaskaydiaCove Nerd Font:size=11;2"
font-5 = "CaskaydiaCove Nerd Font:size=11;2"

modules-left = launcher bspwm
modules-center = spotify-status
modules-right = pulseaudio temperature updates time powermenu

scroll-up = bspwm-wsnext
scroll-down = bspwm-wsprev
wm-restack = bspwm
override-redirect = false

cursor-click = pointer
cursor-scroll = ns-resize

[module/launcher]
type = custom/text
content = " "
content-margin = 2
click-left = rofi -show drun -theme ~/.config/rofi/config.rasi

[module/updates]
type = custom/script
exec = sh -c 'if command -v paru >/dev/null 2>&1; then paru -Qu; elif command -v yay >/dev/null 2>&1; then yay -Qu; else pacman -Qu; fi' 2>/dev/null | wc -l
exec-if = sh -c 'if command -v paru >/dev/null 2>&1; then paru -Qu; elif command -v yay >/dev/null 2>&1; then yay -Qu; else pacman -Qu; fi' 2>/dev/null | grep -q .
format = " <label> updates"
format-margin = 8
tail = true
interval = 300
click-left = alacritty -e sh -c 'paru -Syu || yay -Syu || pacman -Syu'

[module/xwindow]
type = internal/xwindow
label = %title:0:75:...%
label-empty = Empty
label-empty-font = 2
label-font = 2
format-margin = 4

[module/bspwm]
type = internal/bspwm
format = <label-state>
format-margin = 1
index-sort = true

enable-click = true
reverse-scroll = false
enable-scroll = true

label-focused = %index%
label-focused-underline = ${colors.color1}
label-focused-padding = 2
label-focused-font = 1
label-focused-foreground = ${colors.color1}

label-occupied = %index%
label-occupied-padding = 2
label-occupied-foreground = ${colors.color8}

label-empty = 
label-empty-foreground = ${colors.color8}

label-urgent = !
label-urgent-padding = 2
label-urgent-foreground = ${colors.alert}
label-urgent-font = 1

[module/wlan]
type = internal/network
interface-type = wireless
interval = 3.0

format-connected = <label-connected>
format-connected-prefix = " "
label-connected = %essid%

format-disconnected = <label-disconnected>
format-disconnected-prefix = " "
label-disconnected = disconnected
label-disconnected-foreground = ${colors.color8}

[module/eth]
type = internal/network
interface-type = wired
interval = 3.0

format-connected = <label-connected>
format-connected-prefix = " "
label-connected = %local_ip%

format-disconnected = <label-disconnected>
format-disconnected-prefix = " "
label-disconnected = disconnected
label-disconnected-foreground = ${colors.color8}

[module/time]
type = internal/date
interval = 10
format-margin = 4

time = "%H:%M"
date = "%d %b %Y"

label = %time% | %date%
label-background = ${colors.background}
label-padding = 2

[module/pulseaudio]
type = internal/pulseaudio

format-volume-margin = 2
format-volume = <ramp-volume><label-volume>
label-volume = %percentage%%
format-volume-background = ${colors.background}
format-volume-padding = 2
use-ui-max = false
interval = 5

ramp-volume-0 = " "
ramp-volume-1 = " "
ramp-volume-2 = " "

label-muted = " muted"
label-muted-foreground = ${colors.color8}
label-muted-background = ${colors.background}
label-muted-padding = 2

click-left = pavucontrol &
click-right = pavucontrol &

[module/temperature]
type = internal/temperature
thermal-zone = 0
warn-temperature = 70

format = <ramp> <label>
format-warn = <ramp> <label-warn>

label = %temperature-c%
label-warn = %temperature-c%
label-warn-foreground = ${colors.alert}

ramp-0 = " "
ramp-1 = " "
ramp-2 = " "

[module/powermenu]
type = custom/menu

expand-right = true

format-margin = 2
format-spacing = 2

label-open = " "
label-open-foreground = ${colors.color1}
label-close = " "
label-close-foreground = ${colors.color1}
label-separator = |
label-separator-foreground = ${colors.color8}

menu-0-0 = logout
menu-0-0-exec = bspc quit
menu-0-1 = reboot
menu-0-1-exec = reboot
menu-0-2 = poweroff
menu-0-2-exec = poweroff

[module/spotify-status]
type = custom/script
interval = 1
format-prefix = " "
format = <label>
exec = python3 ~/.config/bin/spotify_status.py -f '{artist}: {song}' 2>/dev/null
format-underline = #1DB954
click-left = playerctl --player=spotify play-pause
click-right = playerctl --player=spotify next
click-middle = playerctl --player=spotify previous

[settings]
screenchange-reload = true
pseudo-transparency = false

[global/wm]
margin-top = 0
margin-bottom = 0
