@theme "/dev/null"

configuration {
    modi: "drun,run,window";
    font: "CaskaydiaCove Nerd Font 12";
    show-icons: true;
    icon-theme: "Papirus";
    terminal: "alacritty";
    drun-display-format: "{name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "  Apps ";
    display-run: "  Run ";
    display-window: "  Window ";
}

* {
    bg: #191724;
    bg-alt: #26233A;
    fg: #E0DEF4;
    fg-alt: #6E6A86;

    background-color: @bg;
    text-color: @fg;
}

window {
    width: 40%;
    height: 50%;
    border: 2px;
    border-color: #EB6F92;
    border-radius: 10px;
    background-color: @bg;
    padding: 20px;
}

mainbox {
    background-color: transparent;
    children: [inputbar, listview];
    spacing: 15px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 10px 15px;
    children: [prompt, entry];
    spacing: 10px;
}

prompt {
    background-color: transparent;
    text-color: #EB6F92;
    font: "CaskaydiaCove Nerd Font 14";
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Search...";
    placeholder-color: @fg-alt;
    cursor: text;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    spacing: 5px;
    fixed-height: false;
    dynamic: true;
}

element {
    background-color: transparent;
    padding: 8px 12px;
    border-radius: 6px;
    spacing: 10px;
}

element-icon {
    size: 24px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element selected {
    background-color: #EB6F92;
    text-color: #191724;
}

element selected .element-icon {
    background-color: transparent;
}

element selected .element-text {
    background-color: transparent;
    text-color: #191724;
}
